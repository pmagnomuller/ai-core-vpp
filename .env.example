# Copy to .env and fill in. docker-compose will load this automatically.

# --- OpenAI ---
OPENAI_API_KEY=sk-replace-me
OPENAI_MODEL=gpt-4o-mini

# --- Producer ---
PRODUCER_DEVICES=1000
PRODUCER_RATE_HZ=1

# --- Postgres ---
POSTGRES_USER=vpp
POSTGRES_PASSWORD=vpp
POSTGRES_DB=vpp

# --- n8n ---
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=admin
