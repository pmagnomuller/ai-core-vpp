      "typeVersion": 3.4,
      "position": [500, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { ok: true, received: $json } }}",
        "options": {}
      },
      "id": "ef6a1e1a-0003-4f5b-8f9b-1a2b3c4d5e6f",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
