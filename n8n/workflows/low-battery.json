            },
            {
              "id": "4",
              "name": "severity",
              "type": "string",
              "value": "warning"
            }
          ]
        },
        "options": {}
      },
      "id": "ef6a1e1a-0002-4f5b-8f9b-1a2b3c4d5e6f",
      "name": "Format Alert",
